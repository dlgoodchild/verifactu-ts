{
  "name": "verifactu",
  "version": "0.1.0",
  "description": "A project-agnostic TypeScript client for Spain's VERI*FACTU invoice-verification scheme (AEAT): records, hash chain, SOAP web service, QR codes, signing and event log.",
  "keywords": [
    "verifactu",
    "veri*factu",
    "aeat",
    "spain",
    "invoice",
    "invoicing",
    "factura",
    "hacienda",
    "tax",
    "xades"
  ],
  "author": "Dave Goodchild",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sample": "ts-node -r tsconfig-paths/register examples/sample/index.ts",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run verify",
    "release:patch": "npm version patch -m \"Release %s\"",
    "release:minor": "npm version minor -m \"Release %s\"",
    "release:major": "npm version major -m \"Release %s\"",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@types/node-forge": "1.3.11",
    "fast-xml-parser": "5.7.2",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/qrcode": "1.5.5",
    "dotenv": "17.3.1",
    "jest": "30.3.0",
    "jest-extended": "7.0.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/verifactu.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/verifactu/issues"
  },
  "homepage": "https://github.com/OWNER/verifactu#readme"
}
